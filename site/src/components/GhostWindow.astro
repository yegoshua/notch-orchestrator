---
// A terminal window somewhere in the dark behind the hero: one of the sessions the island watches.
import { codeLines } from '../lib/code';
import type { StateKind } from '../lib/marks';
import Mark from './Mark.astro';

interface Props {
  title: string;
  kind: StateKind;
  /** Where its top left corner is, in percent of the hero. */
  x: number;
  y: number;
  width: number;
  /** 0 for far away, 1 for close: sets how sharp and bright it is, and how much it moves. */
  depth: number;
  /** Left out on narrow screens. */
  wideOnly?: boolean;
}
const { title, kind, x, y, width, depth, wideOnly = false } = Astro.props;
const lines = codeLines(Math.round(x * 31 + y * 17), 7);
const style = [
  `left: ${x}%`, `top: ${y}%`, `width: ${width}px`,
  // What is far away moves less than the page, so it lags behind it.
  `--speed: ${Math.round((1 - depth) * 180)}`, `--reach: ${Math.round(6 + depth * 26)}`,
  `--blur: ${((1 - depth) * 5).toFixed(1)}px`, `--dim: ${(0.5 + depth * 0.5).toFixed(2)}`,
].join('; ');
---
<div class:list={['ghost', 'layer', { 'wide-only': wideOnly }]} style={style} data-kind={kind} aria-hidden="true">
  <div class="window drift">
    <div class="titlebar"><i></i><i></i><i></i><span><Mark kind={kind} />{title}</span></div>
    <div class="code">
      {lines.map(line => (
        <p style={`padding-left: ${line.indent}%`}>{line.tokens.map((token, index) => <b class={`t${index % 4}`} style={`width: ${token}%`}></b>)}</p>
      ))}
      {kind === 'waiting' && <p class="ask"><em>Allow?</em></p>}
    </div>
  </div>
</div>

<style>
  .ghost { position: absolute; filter: blur(var(--blur)); opacity: var(--dim); }
  .window {
    border-radius: 12px; overflow: hidden;
    background: linear-gradient(155deg, rgb(255 255 255 / 0.07), transparent 40%), #101011;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1), 0 30px 60px -20px #000;
  }
  .titlebar { display: flex; align-items: center; gap: 6px; height: 30px; padding: 0 11px; border-bottom: 1px solid rgb(255 255 255 / 0.05); }
  .titlebar i { width: 8px; height: 8px; border-radius: 50%; background: #262626; }
  .titlebar span { display: flex; align-items: center; gap: 6px; margin-left: 8px; font: 11px var(--mono); color: var(--text3); white-space: nowrap; }
  .code { display: grid; gap: 9px; padding: 14px 14px 18px; }
  .code p { display: flex; gap: 6px; height: 6px; }
  .code b { border-radius: 3px; background: #3a3a3a; }
  .code .t1 { background: #5a4a35; }
  .code .t2 { background: #34465c; }
  .code .t3 { background: #3c5445; }

  [data-kind="waiting"] .window { box-shadow: inset 0 0 0 1px rgb(242 180 65 / 0.45), 0 0 60px -10px rgb(242 180 65 / 0.35), 0 30px 60px -20px #000; }
  .ask { height: auto !important; margin-top: 4px; }
  .ask em { font: 600 11px var(--sans); color: #000; background: linear-gradient(#f8c96a, #efae37); border-radius: 9px; padding: 2px 9px; }

  @media (max-width: 860px) {
    .wide-only { display: none; }
    .ghost { scale: 0.72; transform-origin: top left; }
  }
</style>
