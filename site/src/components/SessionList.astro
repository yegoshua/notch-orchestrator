---
// The list of sessions the island opens on, as SessionListView.swift draws it, with the merge
// requests they pushed to in a section under them.
import { MERGE_REQUESTS, SESSIONS } from '../lib/demo';
import Mark from './Mark.astro';
---
<div class="list">
  {SESSIONS.map(({ kind, group, rows }) => (
    <div class="group" data-state={kind}>
      <p class="group-label">{group} <i>{rows.length}</i></p>
      {rows.map(row => (
        <div class="row">
          <Mark kind={kind} />
          <div class="row-main"><b>{row.title} <small>{row.where}</small></b><span>{row.activity}</span></div>
          <div class="row-side">{row.flag && <em class:list={{ failed: kind === 'failed' }}>{row.flag}</em>}<span>{row.time}</span></div>
        </div>
      ))}
    </div>
  ))}
  <div class="group" data-state="requests">
    <p class="group-label">Merge requests <i>{MERGE_REQUESTS.length}</i></p>
    {MERGE_REQUESTS.map(request => (
      <div class="request">
        <code>!{request.number}</code>
        <b>{request.title}</b>
        <small>{request.project}</small>
        {request.parts.map(part => <span data-kind={part.kind}>{part.text}</span>)}
      </div>
    ))}
  </div>
</div>
