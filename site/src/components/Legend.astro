---
// "How to read the island": the open island on a screen, and the choices that change it.
import { LEGEND, RING_CHOICES } from '../lib/demo';
import Island from './Island.astro';
import Mark from './Mark.astro';
import SessionList from './SessionList.astro';
---
<section class="block" id="read">
  <header class="block-head" data-reveal>
    <h2>How to read the island.</h2>
    <p class="lede">Every state has its own colour and its own shape, so it never rests on colour alone. Counters are numbers beside a mark, not one dot per session.</p>
  </header>
  <div class="read">
    <div class="device" data-reveal>
      <div class="screen" id="screen">
        <Island id="preview" placement="static" label="The open island with a list of sessions"><SessionList /></Island>
        <p class="caption" id="read-caption" aria-live="polite"></p>
      </div>
    </div>
    <div class="controls" data-reveal>
      <h3 id="state-label">State</h3>
      <div class="options" id="state-options" role="group" aria-labelledby="state-label">
        {LEGEND.map(entry => (
          <button type="button" data-state={entry.kind}><Mark kind={entry.kind} /><b>{entry.name}</b><span>{entry.means}</span></button>
        ))}
      </div>
      <h3 id="ring-label">Usage ring</h3>
      <div class="segmented" id="ring-options" role="group" aria-labelledby="ring-label">
        {RING_CHOICES.map(used => <button type="button" data-ring={used ?? ''}>{used === null ? 'No data' : `${used}%`}</button>)}
      </div>
      <p class="fine">The ring is your five-hour limit, and stays quiet until the limit comes close. The weekly limit is in the list and in the menu.</p>
    </div>
  </div>
</section>

<style>
  .read { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); gap: 40px; align-items: start; }
  .device { min-width: 0; padding: 7px; border-radius: 34px; background: linear-gradient(#26282d, #111215 60%); box-shadow: 0 60px 120px -50px #000; }
  .screen {
    display: flex; flex-direction: column; justify-content: space-between; gap: 28px; min-height: 540px;
    border-radius: 27px; overflow: hidden; transition: --glow-color 0.6s;
    background:
      radial-gradient(80% 95% at 50% 0, color-mix(in srgb, var(--glow-color) 40%, transparent), color-mix(in srgb, var(--glow-color) 10%, transparent) 45%, transparent 80%),
      linear-gradient(155deg, rgb(255 255 255 / 0.035), transparent 38%),
      radial-gradient(120% 90% at 78% 115%, #1b2b4d, transparent 55%), #08090c;
  }
  .caption { padding: 0 24px 26px; text-align: center; text-wrap: balance; color: var(--text); font-size: 15px; }

  .controls { display: grid; gap: 14px; }
  .controls h3 { margin-top: 10px; }
  .options { display: grid; gap: 6px; }
  .options button, .segmented button {
    border: 1px solid var(--line); border-radius: 12px; background: #0d0d0d; color: var(--text2);
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .options button { display: grid; grid-template-columns: 16px auto 1fr; align-items: center; gap: 4px 6px; padding: 11px 14px; text-align: left; font-size: 15px; }
  .options b { font-weight: 600; color: var(--text); }
  .options span { color: var(--text3); font-size: 13px; text-align: right; }
  .options button:hover, .segmented button:hover { background: #151515; }
  .options button[aria-pressed="true"], .segmented button[aria-pressed="true"] { background: #1c1c1c; border-color: #3a3a3a; color: var(--text); }
  .segmented { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .segmented button { height: 40px; font-size: 14px; font-variant-numeric: tabular-nums; }

  @media (max-width: 860px) {
    .read { grid-template-columns: 1fr; }
    .screen { min-height: 0; }
  }
  @media (max-width: 480px) {
    .options span { display: none; }
  }
</style>
