---
// "Without the mouse": the editor you are busy in fills the screen behind the keys.
import EditorBackdrop from './EditorBackdrop.astro';
---
<section class="keys" id="keys" data-parallax>
  <div class="backdrop layer" style="--speed: 150" aria-hidden="true">
    <div class="tilt"><EditorBackdrop /></div>
  </div>
  <div class="veil" aria-hidden="true"></div>

  <div class="block content">
    <div data-reveal>
      <h2>Without the mouse.</h2>
      <p class="lede">A hotkey opens the list of sessions from any app. <kbd>⌃⌥Y</kbd> allows the request on the card, <kbd>⌃⌥X</kbd> denies it.</p>
      <div class="try">
        <button type="button" class="keycaps" id="hotkey" aria-expanded="false" aria-label="Open the session list (Control Option N)">
          <kbd data-key="Control">⌃</kbd><kbd data-key="Alt">⌥</kbd><kbd data-key="KeyN">N</kbd>
        </button>
        <p class="fine">Opens the list. Press it right now, or tap the keys.</p>
      </div>
    </div>
    <div class="modes glass" data-reveal>
      <h3>It interrupts as much as you let it</h3>
      <dl>
        <div><dt>Loud</dt><dd>Expands and sounds for every request and every finished turn.</dd></div>
        <div><dt>Smart</dt><dd>Only for a session that is not already in front of you.</dd></div>
        <div><dt>Quiet</dt><dd>Counters only.</dd></div>
      </dl>
      <p class="fine">A Focus silences every mode.</p>
    </div>
  </div>
</section>

<style>
  .keys { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: clip; }

  /* The editor, turned away from the reader and a little out of focus. */
  .backdrop { position: absolute; inset: 0; perspective: 1700px; perspective-origin: 30% 50%; }
  .tilt { position: absolute; left: 38%; top: 9%; transform: rotateY(-24deg) rotateX(7deg) rotateZ(1.5deg); transform-origin: 0 50%; filter: blur(0.6px); }
  .veil {
    position: absolute; inset: 0;
    background:
      linear-gradient(to right, #000 20%, rgb(0 0 0 / 0.5) 44%, transparent 70%),
      linear-gradient(to top, #000 2%, rgb(0 0 0 / 0.5) 30%, transparent 60%, #000 100%);
  }

  .content { position: relative; width: 100%; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 56px; align-items: end; }
  .lede { margin-top: 18px; }
  .lede kbd { color: var(--text); font: inherit; white-space: nowrap; }
  .try { display: flex; align-items: center; gap: 22px; margin-top: 36px; flex-wrap: wrap; }
  .keycaps { display: flex; gap: 8px; }
  .keycaps kbd {
    display: grid; place-items: center; width: 64px; height: 64px; border-radius: 13px;
    font: 500 25px var(--sans); background: linear-gradient(#232323, #131313);
    box-shadow: inset 0 0 0 1px #333, inset 0 1px 0 rgb(255 255 255 / 0.1), 0 3px 0 #050505, 0 14px 30px -10px #000;
    transition: transform 0.08s, background 0.08s, color 0.08s;
  }
  .keycaps:active kbd, .keycaps kbd.down { transform: translateY(2px); background: linear-gradient(#f8c96a, #efae37); color: #000; }

  .modes { backdrop-filter: blur(18px); background: linear-gradient(155deg, rgb(255 255 255 / 0.06), transparent 42%), rgb(10 10 10 / 0.72); }
  .modes dl { margin-top: 16px; display: grid; }
  .modes dl div { display: grid; grid-template-columns: 76px 1fr; gap: 12px; padding: 12px 0; border-top: 1px solid rgb(255 255 255 / 0.07); font-size: 16px; }
  .modes dt { font-weight: 600; }
  .modes dd { color: var(--text2); }
  .modes .fine { padding-top: 12px; border-top: 1px solid rgb(255 255 255 / 0.07); }

  @media (max-width: 860px) {
    .content { grid-template-columns: 1fr; gap: 40px; }
    .tilt { left: 8%; top: 4%; }
    .veil { background: linear-gradient(to top, #000 8%, rgb(0 0 0 / 0.86) 55%, rgb(0 0 0 / 0.55) 80%, #000 100%); }
  }
</style>
