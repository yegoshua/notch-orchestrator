---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
// The app icon, "Keycap", as scripts/make-icon.swift draws it at small sizes.
const icon = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='100 100 824 824'><defs><linearGradient id='t' x2='0' y2='1'><stop stop-color='#3A3B3E'/><stop offset='1' stop-color='#1C1D1F'/></linearGradient><linearGradient id='k' x2='0' y2='1'><stop stop-color='#323232'/><stop offset='1' stop-color='#1A1A1A'/></linearGradient></defs><rect x='100' y='100' width='824' height='824' rx='185' fill='url(#t)'/><rect x='252' y='236' width='520' height='560' rx='104' fill='#050505'/><rect x='280' y='252' width='464' height='476' rx='86' fill='url(#k)'/><circle cx='512' cy='490' r='84' fill='#F2B441'/></svg>`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:title" content="Notch Orchestrator" />
    <meta property="og:description" content="See which Claude Code session needs you, and answer it from the notch." />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent(icon)}`} />
  </head>
  <body>
    <slot />
  </body>
</html>
